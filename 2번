SQLite를 활용한 간단한 DB를 설계하고 구현하시(시나리오는 각자  만들어서 하시오. 반드시 3명 이상을 데이터를 넣고, 검색을 포함해야 합니다. c언어로

#include <stdio.h>
#include <sqlite3.h>

// SELECT 결과를 출력하기 위한 콜백 함수
int callback(void *NotUsed, int argc, char **argv, char **azColName) {
    for (int i = 0; i < argc; i++) {
        printf("%s: %s\n", azColName[i], argv[i] ? argv[i] : "NULL");
    }
    printf("------------------------\n");
    return 0;
}

int main() {
    sqlite3 *db;
    char *err_msg = 0;
    int rc;

    // 1. 데이터베이스 연결 (파일이 없으면 자동 생성)
    rc = sqlite3_open("school.db", &db);
    if (rc != SQLITE_OK) {
        fprintf(stderr, "데이터베이스 열기 실패: %s\n", sqlite3_errmsg(db));
        sqlite3_close(db);
        return 1;
    }

    // 2. 테이블 생성
    char *sql_create = "CREATE TABLE IF NOT EXISTS students (" \
                       "id INTEGER PRIMARY KEY AUTOINCREMENT, " \
                       "name TEXT, " \
                       "age INTEGER, " \
                       "major TEXT);";
    
    rc = sqlite3_exec(db, sql_create, 0, 0, &err_msg);
    if (rc != SQLITE_OK) {
        fprintf(stderr, "테이블 생성 에러: %s\n", err_msg);
        sqlite3_free(err_msg);
        sqlite3_close(db);
        return 1;
    }

    // 3. 3명 이상의 데이터 삽입
    char *sql_insert = "INSERT INTO students (name, age, major) VALUES " \
                       "('김철수', 20, '컴퓨터공학')," \
                       "('이영희', 22, '경영학')," \
                       "('박민수', 21, '전자공학');";
    
    rc = sqlite3_exec(db, sql_insert, 0, 0, &err_msg);
    // (이미 데이터가 들어있는 상태에서 재실행 시 발생하는 UNIQUE/PRIMARY KEY 충돌 등은 예제 편의상 생략)

    // 4. 데이터 검색 기능 (이름이 '김철수'인 학생 검색)
    printf("=== [검색 결과] '김철수' 학생 조회 ===\n");
    char *sql_select = "SELECT * FROM students WHERE name = '김철수';";
    
    rc = sqlite3_exec(db, sql_select, callback, 0, &err_msg);
    if (rc != SQLITE_OK) {
        fprintf(stderr, "검색 에러: %s\n", err_msg);
        sqlite3_free(err_msg);
    }

    // 5. 데이터베이스 연결 해제
    sqlite3_close(db);
    return 0;
}
