높이 N을 입력받아 중앙정렬 피라미드 형태의 문자패턴을 파악하시(홀수 번째 행은 *,짝수 번째 행은 #으로 출력함)

#include <stdio.h>

int main() {
    int N;

    printf("피라미드의 높이(N)를 입력하세요: ");
    scanf("%d", &N);

    // 1부터 N까지 행 반복
    for (int i = 1; i <= N; i++) {
        // 1. 중앙 정렬을 위한 공백 출력 (N - i 개)
        for (int j = 0; j < N - i; j++) {
            printf(" ");
        }

        // 2. 행 번호에 따른 문자 선택 (홀수 행: *, 짝수 행: #)
        char ch = (i % 2 != 0) ? '*' : '#';

        // 3. 패턴 문자 출력 (2 * i - 1 개)
        for (int j = 0; j < 2 * i - 1; j++) {
            printf("%c", ch);
        }

        // 4. 줄바꿈
        printf("\n");
    }

    return 0;
}
